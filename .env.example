# Database Connection (Decoupled for Portability)
# Localhost: DB_HOST=localhost
# DigitalOcean Droplet: DB_HOST=<DROPLET_PUBLIC_IP> or <docker-service-name>
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=FREEPDB1

# Oracle Privileged DBA Account
DB_SYS_USER=SYS
DB_PASSWORD=InsyteOracle23ai#Secure2026

# Application Roles (Least-Privilege Security)
# DDL/ETL Admin User:
APP_ADMIN_USER=INSYTE_ADMIN
APP_ADMIN_PASSWORD=AdminSecurePassword2026!

# Read-Only Reporting Analyst User:
APP_ANALYST_USER=INSYTE_ANALYST
APP_ANALYST_PASSWORD=AnalystSecurePassword2026!

# Web Application Settings
FLASK_APP=app/app.py
FLASK_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=1
SECRET_KEY=insyte_secret_key_oracle23ai_academic_2026

# Vector Embeddings Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
